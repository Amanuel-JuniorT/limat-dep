generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        Int        @id @default(autoincrement())
  phone     String     @unique
  email     String?    @unique
  name      String
  password  String
  role      Role       @default(SELLER)
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Legacy (kept for history)
  transactions Transactions[]
  purchases    Purchases[]

  // New
  allocations  Allocation[]
  salesReports SalesReport[]
  spinReports  SpinReport[]
  wastages     Wastage[]
  closedDates  ClosedDate[]
  priceHistory ItemPriceHistory[]
  priceCorrectionLogs PriceCorrectionLog[]
}

enum Role {
  ADMIN
  STOCK  // Stock Department: inventory, purchases, allocation, wastage
  SELLER // Seller: sales reports, spin reports (events), closed dates
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Items & Pricing ──────────────────────────────────────────────────────────

model Items {
  id          Int      @id @default(autoincrement())
  name        String
  sku         String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices             ItemPrices[]
  priceHistory       ItemPriceHistory[]
  priceCorrectionLogs PriceCorrectionLog[]
  // Legacy
  transactionItems   TransactionItems[]
  purchaseItems      PurchaseItems[]
  inventoryMovements InventoryMovements[]
  // New
  allocationItems    AllocationItems[]
  salesReportItems   SalesReportItems[]
  spinReportItems    SpinReportItems[]
  wastages           Wastage[]
}

enum PriceType {
  SELLING
  COST
}

model ItemPrices {
  id            Int       @id @default(autoincrement())
  itemId        Int
  item          Items     @relation(fields: [itemId], references: [id])
  price         Decimal   @db.Decimal(12, 2)
  priceType     PriceType @default(SELLING)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([itemId])
  @@index([itemId, priceType])
}

// Active price versioning table — replaces ItemPrices as source of truth for new records.
// Each entry represents a price change event. The effective price on any date
// is the most recent entry where effectiveFrom <= targetDate.
model ItemPriceHistory {
  id            Int        @id @default(autoincrement())
  itemId        Int
  item          Items      @relation(fields: [itemId], references: [id])
  costPrice     Decimal    @db.Decimal(12, 2)
  sellingPrice  Decimal    @db.Decimal(12, 2)
  effectiveFrom DateTime
  notes         String?
  createdBy     Int
  user          User       @relation(fields: [createdBy], references: [id])
  purchaseId    Int?       // optional link to the intake that triggered this change
  purchase      Purchases? @relation(fields: [purchaseId], references: [id])
  createdAt     DateTime   @default(now())

  @@index([itemId])
  @@index([itemId, effectiveFrom])
}

model PriceCorrectionLog {
  id             Int      @id @default(autoincrement())
  itemId         Int
  item           Items    @relation(fields: [itemId], references: [id])
  fieldCorrected String   // "SELLING" | "COST"
  oldPrice       Decimal  @db.Decimal(12, 2)
  newPrice       Decimal  @db.Decimal(12, 2)
  recordsUpdated Int
  correctedBy    Int
  user           User     @relation(fields: [correctedBy], references: [id])
  createdAt      DateTime @default(now())

  @@index([itemId])
}

// ─── Stock Destinations ───────────────────────────────────────────────────────
// Represents where stock lives outside the main warehouse.
// The warehouse itself is implicit (not a destination record).

enum DestinationType {
  SHOP         // The permanent shop (only one)
  EVENT_WINDOW // A temporary event window / table
}

model StockDestination {
  id         Int             @id @default(autoincrement())
  name       String          // e.g. "Shop", "Event Table A", "Window 2"
  type       DestinationType
  isActive   Boolean         @default(true)
  notes      String?
  spinPrice  Decimal         @default(30) @db.Decimal(12, 2) // price per spin (EVENT_WINDOW only)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  allocations  Allocation[]
  salesReports SalesReport[]
  spinReports  SpinReport[]
  wastages     Wastage[]
  closedDates  ClosedDate[]
}

// ─── Inventory Movements ──────────────────────────────────────────────────────

enum MovementType {
  PURCHASE         // Stock received into warehouse
  ADJUSTMENT       // Manual correction
  ALLOCATION_OUT   // Warehouse → destination
  ALLOCATION_IN    // Destination receives from warehouse
  ALLOCATION_RETURN // Destination → back to warehouse (event close)
  SHOP_SALE        // Deduct from shop stock
  EVENT_SALE       // Deduct from event window stock
  SPIN_REWARD      // Item rewarded via spin (deduct from destination)
  WASTAGE          // Stock written off
  // SALE kept as legacy only — no new entries
  SALE
}

model InventoryMovements {
  id             Int          @id @default(autoincrement())
  itemId         Int
  item           Items        @relation(fields: [itemId], references: [id])
  type           MovementType
  quantityChange Int          // positive = in, negative = out
  destinationId  Int?         // null = warehouse movement
  referenceId    Int?
  referenceType  String?
  createdAt      DateTime     @default(now())

  @@index([itemId])
  @@index([itemId, destinationId])
  @@index([createdAt])
}

// ─── Allocation ───────────────────────────────────────────────────────────────

model Allocation {
  id            Int              @id @default(autoincrement())
  destinationId Int
  destination   StockDestination @relation(fields: [destinationId], references: [id])
  isReturn      Boolean          @default(false) // true = return to warehouse
  date          DateTime         @default(now())
  notes         String?
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
  createdAt     DateTime         @default(now())

  items AllocationItems[]

  @@index([destinationId])
  @@index([userId])
}

model AllocationItems {
  id           Int        @id @default(autoincrement())
  allocationId Int
  allocation   Allocation @relation(fields: [allocationId], references: [id])
  itemId       Int
  item         Items      @relation(fields: [itemId], references: [id])
  quantity     Int

  @@index([allocationId])
  @@index([itemId])
}

// ─── Sales Reports ────────────────────────────────────────────────────────────
// Replaces the live POS for both shop (daily) and event (end-of-event) sales.

model SalesReport {
  id             Int              @id @default(autoincrement())
  destinationId  Int
  destination    StockDestination @relation(fields: [destinationId], references: [id])
  saleDate       DateTime         // The actual date of the sale
  subtotal       Decimal          @db.Decimal(12, 2)
  tipAmount      Decimal?         @db.Decimal(12, 2)
  totalAmount    Decimal          @db.Decimal(12, 2)
  paymentMethod  PaymentMethod    @default(CASH)
  paymentDetails Json?
  notes          String?
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items SalesReportItems[]

  @@index([destinationId])
  @@index([saleDate])
  @@index([userId])
}

model SalesReportItems {
  id            Int           @id @default(autoincrement())
  salesReportId Int
  salesReport   SalesReport   @relation(fields: [salesReportId], references: [id])
  itemId        Int
  item          Items         @relation(fields: [itemId], references: [id])
  quantity      Int
  unitPrice     Decimal       @db.Decimal(12, 2)
  costPrice     Decimal?      @db.Decimal(12, 2) // cost at time of sale (for margin)
  subtotal      Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  tipAmount     Decimal?      @default(0) @db.Decimal(12, 2)
  notes         String?

  @@index([salesReportId])
  @@index([itemId])
}

// ─── Spin Reports ─────────────────────────────────────────────────────────────
// Events only. Each spin costs 30 ETB. Winners may receive an item.

model SpinReport {
  id             Int              @id @default(autoincrement())
  destinationId  Int              // Must be an EVENT_WINDOW destination
  destination    StockDestination @relation(fields: [destinationId], references: [id])
  reportDate     DateTime
  spinCount      Int              // Total number of spins
  revenuePerSpin Decimal          @default(30) @db.Decimal(12, 2)
  subtotal       Decimal          @db.Decimal(12, 2) // spinCount × revenuePerSpin
  tipAmount      Decimal?         @db.Decimal(12, 2)
  totalAmount    Decimal          @db.Decimal(12, 2)
  paymentMethod  PaymentMethod    @default(CASH)
  paymentDetails Json?
  notes          String?
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  items SpinReportItems[]

  @@index([destinationId])
  @@index([reportDate])
}

enum EventRecordType {
  SPIN
  SALE
}

model SpinReportItems {
  id            Int             @id @default(autoincrement())
  spinReportId  Int
  spinReport    SpinReport      @relation(fields: [spinReportId], references: [id])
  type          EventRecordType @default(SPIN)
  itemId        Int?
  item          Items?          @relation(fields: [itemId], references: [id])
  spinCount     Int             @default(1)
  quantity      Int             @default(0) // quantity of item sold or rewarded
  unitPrice     Decimal         @default(0) @db.Decimal(12, 2)
  costPrice     Decimal?        @db.Decimal(12, 2) // cost at time of sale/reward (for margin)
  subtotal      Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod   @default(CASH)
  tipAmount     Decimal?        @default(0) @db.Decimal(12, 2)
  notes         String?

  @@index([spinReportId])
  @@index([itemId])
}

// ─── Wastage ──────────────────────────────────────────────────────────────────

model Wastage {
  id            Int               @id @default(autoincrement())
  itemId        Int
  item          Items             @relation(fields: [itemId], references: [id])
  quantity      Int
  date          DateTime          @default(now())
  destinationId Int?              // null = warehouse wastage
  destination   StockDestination? @relation(fields: [destinationId], references: [id])
  reason        String?
  userId        Int
  user          User              @relation(fields: [userId], references: [id])
  createdAt     DateTime          @default(now())

  @@index([itemId])
  @@index([date])
}

// ─── Closed Dates ─────────────────────────────────────────────────────────────

model ClosedDate {
  id            Int              @id @default(autoincrement())
  date          DateTime
  destinationId Int
  destination   StockDestination @relation(fields: [destinationId], references: [id])
  reason        String?
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
  createdAt     DateTime         @default(now())

  @@unique([date, destinationId])
  @@index([destinationId])
}

// ─── Legacy: Transactions (POS) ───────────────────────────────────────────────
// Kept for historical data. No new entries are created.

enum TransactionType {
  SALE
  SPIN
}

enum PaymentMethod {
  CASH
  TELEBIRR
  CBE
  CUSTOM
}

model Transactions {
  id             Int             @id @default(autoincrement())
  type           TransactionType
  subtotal       Decimal         @db.Decimal(12, 2)
  tipAmount      Decimal?        @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  paymentMethod  PaymentMethod   @default(CASH)
  userId         Int
  user           User            @relation(fields: [userId], references: [id])
  createdAt      DateTime        @default(now())
  paymentDetails Json?
  spinResult     String?

  items TransactionItems[]

  @@index([userId])
  @@index([createdAt])
}

model TransactionItems {
  id            Int          @id @default(autoincrement())
  transactionId Int
  transaction   Transactions @relation(fields: [transactionId], references: [id])
  itemId        Int
  item          Items        @relation(fields: [itemId], references: [id])
  quantity      Int
  unitPrice     Decimal      @db.Decimal(12, 2)
  subtotal      Decimal      @db.Decimal(12, 2)

  @@index([transactionId])
  @@index([itemId])
}

// ─── Legacy: Purchases ────────────────────────────────────────────────────────

model Purchases {
  id            Int      @id @default(autoincrement())
  supplierName  String?
  invoiceNumber String?
  totalCost     Decimal  @db.Decimal(12, 2)
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())

  items        PurchaseItems[]
  priceHistory ItemPriceHistory[]

  @@index([userId])
}

model PurchaseItems {
  id         Int       @id @default(autoincrement())
  purchaseId Int
  purchase   Purchases @relation(fields: [purchaseId], references: [id])
  itemId     Int
  item       Items     @relation(fields: [itemId], references: [id])
  quantity   Int
  unitCost   Decimal   @db.Decimal(12, 2)
  subtotal   Decimal   @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([itemId])
}
